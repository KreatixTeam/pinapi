# Pinterest account used for the internal session (required for live use)
PINTEREST_EMAIL=
PINTEREST_PASSWORD=
PINTEREST_USERNAME=

# Optional: HTTP(S)/SOCKS proxy for all Pinterest traffic
PINTEREST_PROXY=

# Comma-separated API keys your clients must send as "Authorization: Bearer <key>"
# Leave empty for open access (dev / trusted-network use only)
PINAPI_API_KEYS=

PINAPI_CRED_ROOT=./data/creds
PINAPI_UPLOAD_DIR=./data/uploads
PINAPI_AUTO_LOGIN=true
PINAPI_LOGIN_LANG=en
PINAPI_MAX_PAGES=10
