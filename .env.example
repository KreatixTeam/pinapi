# Pinterest account for the internal session. Optional: public reads
# (search, user pins/boards, pin load, board feed) work anonymously.
# Writes, home feed and conversations require a logged-in account.
PINTEREST_EMAIL=
PINTEREST_PASSWORD=
PINTEREST_USERNAME=

# Optional: JSON object of cookies to seed the session with
# (skips credential login), e.g. {"_pinterest_sess": "..."}
PINTEREST_COOKIES=

# Optional: HTTP(S)/SOCKS5 proxy for all Pinterest traffic
PINTEREST_PROXY=

# Comma-separated API keys your clients must send as "Authorization: Bearer <key>"
# Leave empty for open access (dev / trusted-network use only)
PINAPI_API_KEYS=

PINAPI_CRED_ROOT=./data/creds
PINAPI_UPLOAD_DIR=./data/uploads
PINAPI_MAX_PAGES=10
PINAPI_BIND=0.0.0.0:8000
